/* pages/profile/profile.wxss */

.page { padding: 40rpx 24rpx 60rpx; }

/* ============ 顶部身份 ============ */
.hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 8rpx;
}
.hero-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--c-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  flex: 0 0 auto;
}
.hero-info { flex: 1; min-width: 0; }
.hero-name { font-size: 40rpx; font-weight: 600; }
.hero-role {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--c-text-sub);
}

/* ============ 统计卡 ============ */
.stat {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
}
.stat-num {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--c-primary);
  line-height: 1.1;
}
.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--c-text-sub);
}
.stat-arrow {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  color: var(--c-text-light);
  font-size: 30rpx;
}

/* ============ 列表条目 ============ */
.entry {
  padding: 30rpx 4rpx;
  font-size: 29rpx;
}
.entry:active { opacity: .6; }
.entry-arrow { color: var(--c-text-light); font-size: 26rpx; }

/* ============ 管理板块 ============ */
.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 44rpx 8rpx 18rpx;
}
.sec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text-sub);
}
.sec-lock {
  font-size: 23rpx;
  color: var(--c-text-light);
}

.role-note {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  background: #FFF6E8;
  border-radius: var(--r-md);
  font-size: 24rpx;
  color: #A9762A;
  line-height: 1.7;
}
.role-note text { display: block; }

/* ============ 底部 ============ */
.foot {
  margin-top: 70rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--c-text-light);
}
.foot-tip {
  display: block;
  margin-top: 10rpx;
  color: #E4DDE0;
}
