<!-- pages/order-success/order-success.wxml -->
<view class="page">

  <!-- 背景里飘的小心心（纯装饰，不加动画库） -->
  <view class="blob blob-1">❤</view>
  <view class="blob blob-2">❤</view>
  <view class="blob blob-3">❤</view>

  <!-- ============ 标题 ============ -->
  <view class="hero {{showTitle ? 'in' : ''}}">
    <view class="hero-emoji">🍽</view>
    <view class="hero-title">{{copy.successTitle}}</view>
    <view class="hero-sub">{{herName}} 点了 {{order.items.length}} 道菜</view>
  </view>

  <!-- ============ 今晚的菜单 ============ -->
  <view class="card menu {{showList ? 'in' : ''}}">
    <view class="menu-head">
      <text class="menu-title">今晚的菜单</text>
      <text class="menu-date">{{order.mealDate}}</text>
    </view>

    <view class="menu-item" wx:for="{{order.items}}" wx:key="dishId">
      <view class="menu-dot"></view>
      <text class="menu-name">{{item.name}}</text>
    </view>

    <view class="menu-remark" wx:if="{{order.remark}}">
      <text class="menu-remark-label">她说</text>
      <text class="menu-remark-text">{{order.remark}}</text>
    </view>
  </view>

  <!-- ============ 被跳过的菜（下架/删除） ============ -->
  <view class="skip" wx:if="{{order.skipped.length > 0}}">
    <text>有 {{order.skipped.length}} 道菜不在菜单里了，这次没点上</text>
  </view>

  <!-- ============ 通知状态（长按查看） ============ -->
  <view class="hint" bindlongpress="onLongPressHint">
    <text>{{copy.successSubtitle}}</text>
    <text class="hint-tip">（长按这里可以看通知发出去了没）</text>
  </view>

  <!-- ============ 底部 ============ -->
  <view class="actions safe-bottom">
    <view class="btn btn-primary" bindtap="onContinue">再点一次</view>
    <view class="btn btn-plain" bindtap="onViewOrders">看看以前点过的</view>
  </view>

</view>
