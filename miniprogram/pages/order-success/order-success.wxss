/* pages/order-success/order-success.wxss */

.page {
  min-height: 100vh;
  padding: 60rpx 40rpx 40rpx;
  position: relative;
  overflow: hidden;
}

/* ============ 装饰 ============ */
.blob {
  position: absolute;
  color: #FBD9E2;
  font-size: 40rpx;
  animation: float 4.5s ease-in-out infinite;
  pointer-events: none;
}
.blob-1 { top: 90rpx;  left: 70rpx;  animation-delay: 0s;    font-size: 34rpx; }
.blob-2 { top: 220rpx; right: 80rpx; animation-delay: .9s;   font-size: 48rpx; }
.blob-3 { top: 460rpx; left: 46rpx;  animation-delay: 1.8s;  font-size: 28rpx; }
@keyframes float {
  0%, 100% { transform: translateY(0) scale(1); opacity: .85; }
  50%      { transform: translateY(-26rpx) scale(1.12); opacity: 1; }
}

/* ============ 标题 ============ */
.hero {
  text-align: center;
  padding: 40rpx 0 50rpx;
  opacity: 0;
  transform: translateY(24rpx);
  transition: opacity .5s ease, transform .5s ease;
}
.hero.in { opacity: 1; transform: translateY(0); }

.hero-emoji {
  font-size: 110rpx;
  line-height: 1;
  animation: pop .6s cubic-bezier(.2, 1.6, .4, 1) both;
}
@keyframes pop {
  from { transform: scale(.4); opacity: 0; }
  to   { transform: scale(1);  opacity: 1; }
}
.hero-title {
  margin-top: 26rpx;
  font-size: 46rpx;
  font-weight: 600;
  color: var(--c-text);
  letter-spacing: 1rpx;
}
.hero-sub {
  margin-top: 14rpx;
  font-size: 27rpx;
  color: var(--c-text-sub);
}

/* ============ 菜单卡片 ============ */
.menu {
  opacity: 0;
  transform: translateY(24rpx);
  transition: opacity .45s ease, transform .45s ease;
}
.menu.in { opacity: 1; transform: translateY(0); }

.menu-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--c-border);
}
.menu-title { font-size: 32rpx; font-weight: 600; }
.menu-date { font-size: 24rpx; color: var(--c-text-light); }

.menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
}
.menu-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--c-primary);
  flex: 0 0 auto;
}
.menu-name { font-size: 30rpx; }

.menu-remark {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  background: #FFF6F8;
  border-radius: var(--r-md);
}
.menu-remark-label {
  font-size: 22rpx;
  color: var(--c-primary);
  margin-right: 12rpx;
}
.menu-remark-text { font-size: 26rpx; color: var(--c-text); }

/* ============ 跳过提示 ============ */
.skip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--c-warning, #E8A33D);
}

/* ============ 提示 ============ */
.hint {
  margin-top: 46rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--c-text-sub);
}
.hint-tip {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--c-text-light);
}

/* ============ 操作 ============ */
.actions {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
