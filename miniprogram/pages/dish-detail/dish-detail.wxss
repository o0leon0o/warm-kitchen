/* pages/dish-detail/dish-detail.wxss */

.page { padding: 24rpx 24rpx 40rpx; }

/* ============ 头部 ============ */
.head {
  padding: 8rpx 8rpx 0;
}
.head-name-row { display: flex; align-items: center; gap: 12rpx; }
.head-name { font-size: 44rpx; font-weight: 600; }
.heart { font-size: 32rpx; color: var(--c-primary); }
.head-intro {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--c-text-sub);
}
.head-tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.head-avoid {
  margin-top: 18rpx;
  padding: 14rpx 20rpx;
  background: #FFF6E8;
  border-radius: var(--r-md);
  font-size: 24rpx;
  color: #A9762A;
}

/* ============ 小节标题 ============ */
.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
}
.sec-title::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--c-primary);
  margin-right: 12rpx;
}

/* ============ 配料 ============ */
.ing {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F7F3F5;
  font-size: 28rpx;
}
.ing:last-child { border-bottom: none; }
.ing-name { color: var(--c-text); }
.ing-amount { color: var(--c-text-sub); }

/* ============ 步骤 ============ */
.step {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 18rpx 0;
}
.step-no {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--c-primary-light);
  color: var(--c-primary);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
}
.step-body { flex: 1; min-width: 0; }
.step-text { font-size: 28rpx; line-height: 1.65; }
.step-img {
  width: 100%;
  border-radius: var(--r-md);
  margin-top: 14rpx;
}

/* ============ 小贴士 ============ */
.tip { display: flex; gap: 10rpx; padding: 6rpx 0; }
.tip-dot { color: var(--c-primary); font-weight: 700; }
.tip-text { flex: 1; font-size: 26rpx; color: var(--c-text-sub); line-height: 1.6; }

/* ============ 攻略来源 ============ */
.source {
  padding: 20rpx;
  background: #F8F6F7;
  border-radius: var(--r-md);
}
.source-title {
  font-size: 26rpx;
  color: #4A6FA5;
  word-break: break-all;
}
.source-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--c-text-light);
}

/* ============ 底部操作条 ============ */
.bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  background: rgba(255, 255, 255, .96);
  border-top: 1rpx solid var(--c-border);
  z-index: 20;
}
