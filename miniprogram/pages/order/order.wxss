/* pages/order/order.wxss —— 点菜页 */

.page {
  min-height: 100vh;
  padding-bottom: 220rpx; /* 给底部浮条留位置 */
}

/* ============ 顶部问候 ============ */
.hero {
  padding: 40rpx 32rpx 20rpx;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--c-text);
  letter-spacing: 1rpx;
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--c-text-sub);
}

/* ============ 搜索 ============ */
.search-wrap {
  padding: 4rpx 24rpx 16rpx;
}
.search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 80rpx;
  background: #FFFFFF;
  border-radius: var(--r-full);
  padding: 0 26rpx;
  box-shadow: var(--shadow-card);
}
.search-icon { font-size: 26rpx; opacity: .55; }
.search-input {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  height: 80rpx;
}
.search-ph { color: #C0B9BC; font-size: 26rpx; }
.search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #F0EBED;
  color: #8A8285;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

/* 搜索模式提示条 */
.search-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 32rpx 16rpx;
  font-size: 24rpx;
  color: var(--c-text-sub);
}
.search-tip-cancel { color: var(--c-primary); }

/* ============ 一级分类 ============ */
.cats {
  padding: 4rpx 24rpx 12rpx;
}
/* 分类少：等分铺满一行（不能滑，因为没必要） */
.cats-even {
  display: flex;
  gap: 12rpx;
}
.cat-flex {
  flex: 1;
  justify-content: center;
  padding-left: 12rpx;
  padding-right: 12rpx;
}
/* 分类多：横向可滚动 */
.cats-scrollview {
  white-space: nowrap;
}

.cat {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 22rpx;
  border-radius: var(--r-full);
  background: #FFFFFF;
  font-size: 26rpx;
  color: var(--c-text-sub);
  transition: all .18s;
  box-shadow: var(--shadow-card);
}
.cats-scrollable .cat { margin-right: 12rpx; }
.cat-on {
  background: var(--c-primary);
  color: #FFFFFF;
  font-weight: 500;
  box-shadow: 0 6rpx 18rpx rgba(247, 107, 138, .28);
}
.cat-icon { font-size: 27rpx; }
.cat-count {
  font-size: 20rpx;
  opacity: .65;
  margin-left: 2rpx;
}

/* ============ 主菜二级筛选 ============ */
.subs {
  display: flex;
  gap: 10rpx;
  padding: 2rpx 24rpx 14rpx;
  flex-wrap: wrap;
}
.sub {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--r-full);
  background: #FFFFFF;
  font-size: 23rpx;
  color: var(--c-text-sub);
  border: 2rpx solid var(--c-border);
}
.sub-on {
  background: var(--c-primary-light);
  color: var(--c-primary);
  border-color: var(--c-primary);
  font-weight: 500;
}
.sub-icon { font-size: 24rpx; }
.sub-count { font-size: 20rpx; opacity: .6; }

/* ============ 菜品列表 ============ */
.list {
  padding: 8rpx 24rpx 0;
}
.dish {
  display: flex;
  align-items: center;
  background: var(--c-card);
  border-radius: var(--r-lg);
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow-card);
  border: 2rpx solid transparent;
  transition: transform .1s, border-color .18s, background .18s;
}
.dish:active { transform: scale(.988); }
.dish-on {
  border-color: var(--c-primary);
  background: #FFF9FB;
}

.dish-check { flex: 0 0 auto; margin-right: 20rpx; }
.check-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 3rpx solid #E6DDE1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  transition: all .18s;
}
.check-on {
  background: var(--c-primary);
  border-color: var(--c-primary);
}

.dish-main { flex: 1; min-width: 0; }
.dish-name-row { display: flex; align-items: center; gap: 8rpx; }
.dish-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
}
.heart { font-size: 26rpx; color: var(--c-primary); }

.dish-intro {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--c-text-sub);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dish-tags {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.tag-cat {
  background: #F3F1F6;
  color: #6E6383;
}

.dish-more {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--r-full);
  background: #F7F4F5;
  font-size: 22rpx;
  color: var(--c-text-sub);
}
.dish-more:active { background: #EDE7E9; }

.list-end {
  text-align: center;
  font-size: 22rpx;
  color: var(--c-text-light);
  padding: 30rpx 0 10rpx;
}

/* ============ 底部购物车浮条 ============ */
.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  height: 108rpx;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: var(--r-full);
  box-shadow: 0 10rpx 34rpx rgba(200, 140, 160, .22);
  padding: 10rpx 10rpx 10rpx 20rpx;
  transform: translateY(180rpx);
  opacity: 0;
  transition: transform .22s ease, opacity .22s ease;
  z-index: 20;
}
.cart-bar-on {
  transform: translateY(0);
  opacity: 1;
}
.cart-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}
.cart-badge {
  min-width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--c-primary);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
}
.cart-text {
  font-size: 28rpx;
  color: var(--c-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cart-submit {
  flex: 0 0 auto;
  height: 88rpx;
  padding: 0 40rpx;
  border-radius: var(--r-full);
  background: var(--c-primary);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cart-submit:active { opacity: .85; }

/* ============ 购物车半屏 ============ */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .38);
  z-index: 30;
  animation: fadeIn .18s ease;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 28rpx 24rpx;
  z-index: 31;
  max-height: 72vh;
  display: flex;
  flex-direction: column;
  animation: slideUp .24s ease;
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

.sheet-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--c-border);
}
.sheet-title { font-size: 34rpx; font-weight: 600; }
.sheet-count { font-size: 24rpx; color: var(--c-text-sub); }

.sheet-list {
  flex: 1;
  max-height: 40vh;
  padding: 8rpx 0;
}
.sheet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid #F7F3F5;
}
.sheet-item-name { font-size: 30rpx; color: var(--c-text); }
.sheet-item-del {
  padding: 8rpx 22rpx;
  border-radius: var(--r-full);
  background: #FDF0F2;
  color: var(--c-danger);
  font-size: 24rpx;
}
.sheet-item-del:active { background: #F9E2E6; }
.sheet-empty {
  text-align: center;
  color: var(--c-text-light);
  font-size: 26rpx;
  padding: 40rpx 0;
}

.sheet-remark {
  padding: 12rpx 0 4rpx;
}
.remark-input {
  width: 100%;
  min-height: 80rpx;
  background: #F8F6F7;
  border-radius: var(--r-md);
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}
.remark-ph { color: #BBB3B6; font-size: 25rpx; }

.sheet-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 18rpx;
}
